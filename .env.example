# FriendlyFlights — environment configuration
# Copy this file to ".env" if you need to override defaults, then restart.

# ── Flight data provider: fli (free, no API key) ─────────────────────
# The app uses the `fli` Python library to read Google Flights — free,
# no monthly minimum. One-time setup:
#     pip install flights
# If the Python interpreter isn't reachable as `python`, set its path:
# PYTHON_BIN=python3

# ── Server port (optional) ───────────────────────────────────────────
# PORT=3001
