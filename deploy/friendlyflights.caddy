friendlyflights.es, www.friendlyflights.es {
	encode zstd gzip

	# Enforce HTTPS — HSTS 1 year, includeSubDomains
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	reverse_proxy friendlyflights-app:3001
}

# Fallback para pruebas antes de que se propague el DNS del dominio real.
http://friendlyflights.167-233-99-156.sslip.io {
	encode gzip
	reverse_proxy friendlyflights-app:3001
}
